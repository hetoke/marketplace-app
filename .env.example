DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=marketplace
SPRING_PROFILES_ACTIVE=
JWT_ACCESS_SECRET=change-this-to-a-256-bit-secret-in-production
JWT_REFRESH_SECRET=change-this-to-a-256-bit-secret-in-production

# Supabase Storage
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_NAME=marketplace-images

# Image Sync
IMAGE_SYNC_ENABLED=true
IMAGE_SYNC_FIXED_DELAY=3600000

# SEPay
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_ENVIRONMENT=sandbox

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
