DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=marketplace
SPRING_PROFILES_ACTIVE=
JWT_ACCESS_SECRET=change-this-to-a-256-bit-access-secret-in-production
JWT_REFRESH_SECRET=change-this-to-a-256-bit-refresh-secret-in-production
REDIS_HOST=localhost
REDIS_PORT=6379

# Admin
ADMIN_EMAIL=admin@marketplace.com
ADMIN_PASSWORD=Admin123!

# Supabase Storage
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_NAME=marketplace-images

# SEPay
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_ENVIRONMENT=sandbox
SEPAY_SUCCESS_URL=http://localhost:3000/orders/{orderId}?payment=success
SEPAY_ERROR_URL=http://localhost:3000/orders/{orderId}?payment=error
SEPAY_CANCEL_URL=http://localhost:3000/orders/{orderId}?payment=cancelled

# Google OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@marketplace.com
FRONTEND_URL=http://localhost:3000

# Webhook
WEBHOOK_SECRET=changeme

# Upload
UPLOAD_MAX_IMAGES_PER_PRODUCT=10
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif
UPLOAD_SIGNED_URL_EXPIRY_HOURS=2
